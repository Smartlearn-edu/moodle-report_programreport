{{!
    @template report_programreport/matrix_table

    Matrix table partial displaying students and sequential curriculum courses.
}}

<div class="report-programreport-matrix-wrapper mb-4">
    <div class="table-responsive">
        <table class="table report-programreport-table table-bordered table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="col-sticky-student align-middle text-start py-3 px-3">
                        <div class="fw-bold text-dark">{{#str}}student, report_programreport{{/str}}</div>
                    </th>
                    {{#courses}}
                    <th class="text-center align-middle course-col-header py-3 px-2" style="min-width: 140px; max-width: 180px;">
                        <a href="{{{config.wwwroot}}}/course/view.php?id={{id}}" target="_blank" class="fw-bold text-dark text-decoration-none course-link" title="{{fullname}}">
                            {{shortname}}
                        </a>
                        <div class="small text-muted text-truncate" title="{{fullname}}">{{fullname}}</div>
                    </th>
                    {{/courses}}
                    <th class="text-center align-middle col-summary-header py-3 px-2" style="min-width: 110px;">
                        <div class="fw-bold">{{#str}}completedcourses, report_programreport{{/str}}</div>
                    </th>
                    <th class="text-center align-middle col-summary-header py-3 px-2" style="min-width: 120px;">
                        <div class="fw-bold">{{#str}}progavg, report_programreport{{/str}}</div>
                    </th>
                    <th class="text-center align-middle col-summary-header py-3 px-2" style="min-width: 130px;">
                        <div class="fw-bold">{{#str}}progstatus, report_programreport{{/str}}</div>
                    </th>
                </tr>
            </thead>
            <tbody>
                {{#students}}
                <tr>
                    <td class="col-sticky-student text-start px-3 py-2">
                        <a href="{{{student_url}}}" class="fw-bold text-decoration-none text-primary d-block text-truncate" style="max-width: 220px;" title="{{#str}}viewstudentreport, report_programreport{{/str}}">
                            {{fullname}}
                        </a>
                        {{#idnumber}}
                        <div class="small text-muted">{{idnumber}}</div>
                        {{/idnumber}}
                        {{^idnumber}}
                        {{#email}}
                        <div class="small text-muted text-truncate" style="max-width: 220px;" title="{{email}}">{{email}}</div>
                        {{/email}}
                        {{/idnumber}}
                    </td>
                    {{#courses}}
                    <td class="text-center align-middle cell-grade px-2 py-2">
                        <a href="{{{grader_url}}}" target="_blank" class="grade-badge {{badge_class}} text-decoration-none d-inline-block" title="{{tooltip}}">
                            {{percentage_formatted}}
                        </a>
                    </td>
                    {{/courses}}
                    <td class="text-center align-middle fw-semibold text-secondary px-2 py-2">
                        {{completed_ratio}}
                    </td>
                    <td class="text-center align-middle fw-bold fs-6 px-2 py-2 text-dark">
                        {{prog_avg_formatted}}
                    </td>
                    <td class="text-center align-middle px-2 py-2">
                        <span class="badge {{prog_status_badge}} px-2 py-1">
                            {{prog_status_label}}
                        </span>
                    </td>
                </tr>
                {{/students}}
            </tbody>
            <tfoot>
                <tr class="summary-footer-row row-average">
                    <td class="col-sticky-student text-start px-3 py-2 fw-bold">
                        {{#str}}courseaverages, report_programreport{{/str}}
                    </td>
                    {{#course_stats}}
                    <td class="text-center align-middle fw-bold px-2 py-2">
                        {{average_formatted}}
                    </td>
                    {{/course_stats}}
                    <td class="text-center align-middle text-muted">-</td>
                    <td class="text-center align-middle fw-bold fs-6 text-primary px-2 py-2">
                        {{kpis.cohort_average_formatted}}
                    </td>
                    <td class="text-center align-middle text-muted">-</td>
                </tr>
                <tr class="summary-footer-row row-passrate">
                    <td class="col-sticky-student text-start px-3 py-2 fw-bold">
                        {{#str}}passrate, report_programreport{{/str}}
                    </td>
                    {{#course_stats}}
                    <td class="text-center align-middle fw-bold text-success px-2 py-2">
                        {{pass_rate_formatted}}
                    </td>
                    {{/course_stats}}
                    <td class="text-center align-middle text-muted">-</td>
                    <td class="text-center align-middle text-muted">-</td>
                    <td class="text-center align-middle text-muted">-</td>
                </tr>
                <tr class="summary-footer-row row-completed">
                    <td class="col-sticky-student text-start px-3 py-2 fw-bold">
                        {{#str}}completedcount, report_programreport{{/str}}
                    </td>
                    {{#course_stats}}
                    <td class="text-center align-middle fw-bold text-dark px-2 py-2">
                        {{completed_count}}
                    </td>
                    {{/course_stats}}
                    <td class="text-center align-middle text-muted">-</td>
                    <td class="text-center align-middle text-muted">-</td>
                    <td class="text-center align-middle text-muted">-</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

{{!
    @template report_programreport/index

    Main page template for Program Report.
}}

<div class="report-programreport-wrapper container-fluid px-0">

    <!-- Top Action & Selection Bar -->
    <div class="card shadow-sm border-0 mb-4 report-programreport-header-card">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-6 col-md-12">
                    {{#logo_html}}
                    <div class="report-logo-wrapper mb-2">
                        {{{logo_html}}}
                    </div>
                    {{/logo_html}}
                    <h2 class="h4 mb-1 fw-bold text-dark d-flex align-items-center">
                        <i class="fa fa-th-large text-primary me-2"></i>
                        {{#selected_program_name}}{{selected_program_name}}{{/selected_program_name}}
                        {{^selected_program_name}}{{pluginname}}{{/selected_program_name}}
                    </h2>
                    <p class="text-muted small mb-0">{{#str}}selectprogram_help, report_programreport{{/str}}</p>
                </div>

                <div class="col-lg-6 col-md-12 text-lg-end">
                    <div class="d-inline-flex flex-wrap justify-content-lg-end align-items-center gap-2">
                        <form method="get" action="{{{config.wwwroot}}}/report/programreport/index.php" class="d-inline-block m-0">
                            <select name="program" class="form-select form-select-sm d-inline-block w-auto fw-semibold border-primary" onchange="this.form.submit()">
                                <option value="">-- {{#str}}selectprogram, report_programreport{{/str}} --</option>
                                {{#programs_options}}
                                <option value="{{key}}" {{#is_selected}}selected{{/is_selected}}>{{fullname}}</option>
                                {{/programs_options}}
                            </select>
                            <noscript>
                                <button type="submit" class="btn btn-sm btn-primary">Go</button>
                            </noscript>
                        </form>

                        {{#has_selected_program}}
                        <div class="dropdown btn-group">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary dropdown-toggle"
                                    data-toggle="dropdown"
                                    data-bs-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <i class="fa fa-download me-1"></i> {{#str}}export, report_programreport{{/str}}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <a class="dropdown-item py-2" href="{{{export_excel_url}}}">
                                        <i class="fa fa-file-excel-o text-success me-2"></i> {{#str}}export_excel, report_programreport{{/str}}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="{{{export_csv_url}}}">
                                        <i class="fa fa-file-text-o text-secondary me-2"></i> {{#str}}export_csv, report_programreport{{/str}}
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" href="{{{export_pdf_url}}}">
                                        <i class="fa fa-file-pdf-o text-danger me-2"></i> {{#str}}export_pdf, report_programreport{{/str}}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        {{/has_selected_program}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{^has_programs}}
    <div class="alert alert-warning d-flex align-items-center shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle fa-2x me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">{{#str}}pluginname, report_programreport{{/str}}</h5>
            <p class="mb-0">{{#str}}noprogramsfound, report_programreport{{/str}}</p>
        </div>
    </div>
    {{/has_programs}}

    {{#has_programs}}
    {{^has_selected_program}}
    <div class="alert alert-info d-flex align-items-center shadow-sm" role="alert">
        <i class="fa fa-info-circle fa-2x me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">{{#str}}selectprogram, report_programreport{{/str}}</h5>
            <p class="mb-0">{{#str}}noprogramselected, report_programreport{{/str}}</p>
        </div>
    </div>
    {{/has_selected_program}}

    {{#has_selected_program}}
    <!-- Top KPI Cards Row -->
    <div class="row g-3 mb-4 report-programreport-kpis">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm kpi-card kpi-students h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">{{#str}}kpi_totalstudents, report_programreport{{/str}}</span>
                        <h3 class="fw-bold mb-0 mt-1 text-dark">{{kpis.total_students}}</h3>
                    </div>
                    <div class="kpi-icon-wrapper rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="fa fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm kpi-card kpi-courses h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">{{#str}}kpi_totalcourses, report_programreport{{/str}}</span>
                        <h3 class="fw-bold mb-0 mt-1 text-dark">{{kpis.total_courses}}</h3>
                    </div>
                    <div class="kpi-icon-wrapper rounded-circle bg-info bg-opacity-10 text-info p-3">
                        <i class="fa fa-graduation-cap fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm kpi-card kpi-completion h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">{{#str}}kpi_completionrate, report_programreport{{/str}}</span>
                        <h3 class="fw-bold mb-0 mt-1 text-success">{{kpis.completion_rate_formatted}}</h3>
                    </div>
                    <div class="kpi-icon-wrapper rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="fa fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm kpi-card kpi-cohort h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">{{#str}}kpi_cohortaverage, report_programreport{{/str}}</span>
                        <h3 class="fw-bold mb-0 mt-1 text-primary">{{kpis.cohort_average_formatted}}</h3>
                    </div>
                    <div class="kpi-icon-wrapper rounded-circle bg-purple bg-opacity-10 text-purple p-3">
                        <i class="fa fa-line-chart fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="card shadow-sm border-0 mb-4 report-programreport-filterbar">
        <div class="card-body p-3">
            <form method="get" action="{{{config.wwwroot}}}/report/programreport/index.php" class="row g-2 align-items-center">
                <input type="hidden" name="program" value="{{selected_program_key}}">

                <div class="col-md-5 col-sm-12">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="{{#str}}search_placeholder, report_programreport{{/str}}" value="{{search_query}}">
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">{{#str}}filter_status, report_programreport{{/str}}</span>
                        <select name="status" class="form-select">
                            <option value="all" {{#status_all_selected}}selected{{/status_all_selected}}>{{#str}}filter_all, report_programreport{{/str}}</option>
                            <option value="completed" {{#status_completed_selected}}selected{{/status_completed_selected}}>{{#str}}filter_completed, report_programreport{{/str}}</option>
                            <option value="inprogress" {{#status_inprogress_selected}}selected{{/status_inprogress_selected}}>{{#str}}filter_inprogress, report_programreport{{/str}}</option>
                            <option value="notstarted" {{#status_notstarted_selected}}selected{{/status_notstarted_selected}}>{{#str}}filter_notstarted, report_programreport{{/str}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">{{#str}}perpage, report_programreport{{/str}}</span>
                        <select name="perpage" class="form-select">
                            <option value="25" {{#perpage_25_selected}}selected{{/perpage_25_selected}}>25</option>
                            <option value="50" {{#perpage_50_selected}}selected{{/perpage_50_selected}}>50</option>
                            <option value="100" {{#perpage_100_selected}}selected{{/perpage_100_selected}}>100</option>
                            <option value="0" {{#perpage_all_selected}}selected{{/perpage_all_selected}}>{{#str}}all, report_programreport{{/str}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2 col-sm-12 text-md-end">
                    <button type="submit" class="btn btn-sm btn-primary me-1">
                        <i class="fa fa-filter me-1"></i> {{#str}}filter_button, report_programreport{{/str}}
                    </button>
                    <a href="{{{reset_url}}}" class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-refresh"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Matrix View -->
    {{^has_courses}}
    <div class="alert alert-warning shadow-sm" role="alert">
        <i class="fa fa-exclamation-circle me-2"></i> {{#str}}nocoursesinprogram, report_programreport{{/str}}
    </div>
    {{/has_courses}}

    {{#has_courses}}
    {{^has_students}}
    <div class="alert alert-info shadow-sm" role="alert">
        <i class="fa fa-info-circle me-2"></i> {{#str}}nostudentsinprogram, report_programreport{{/str}}
    </div>
    {{/has_students}}

    {{#has_students}}
    <div class="d-flex align-items-center justify-content-between mb-2">
        <small class="text-muted"><i class="fa fa-info-circle me-1"></i> {{#str}}sticky_columns_hint, report_programreport{{/str}}</small>
        {{#pagination.has_pages}}
        <small class="text-muted fw-semibold">{{pagination.showing_text}}</small>
        {{/pagination.has_pages}}
    </div>

    {{> report_programreport/matrix_table }}

    {{#pagination.has_pages}}
    <nav aria-label="Program matrix pagination" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            {{#pagination.first_url}}
            <li class="page-item"><a class="page-link" href="{{{pagination.first_url}}}">&laquo;</a></li>
            {{/pagination.first_url}}
            {{#pagination.prev_url}}
            <li class="page-item"><a class="page-link" href="{{{pagination.prev_url}}}">&lsaquo;</a></li>
            {{/pagination.prev_url}}

            {{#pagination.pages}}
            <li class="page-item {{#is_active}}active{{/is_active}}">
                <a class="page-link" href="{{{url}}}">{{number}}</a>
            </li>
            {{/pagination.pages}}

            {{#pagination.next_url}}
            <li class="page-item"><a class="page-link" href="{{{pagination.next_url}}}">&rsaquo;</a></li>
            {{/pagination.next_url}}
            {{#pagination.last_url}}
            <li class="page-item"><a class="page-link" href="{{{pagination.last_url}}}">&raquo;</a></li>
            {{/pagination.last_url}}
        </ul>
    </nav>
    {{/pagination.has_pages}}

    {{/has_students}}
    {{/has_courses}}

    {{/has_selected_program}}
    {{/has_programs}}

</div>
